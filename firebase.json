{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/searchVideos", "function": "searchVideos" },
      { "source": "/generateQuiz", "function": "generateQuiz" },
      { "source": "/getVideoDetails", "function": "getVideoDetails" },
      {
        "source": "/getPopularVideos", // New rule
        "function": "getPopularVideos"
      },
      {
        "source": "/suggestV3{,/**}",
        "function": {
          "functionId": "suggestV3",
          "region": "us-central1",
          "pinTag": true
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}