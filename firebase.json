{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/suggest/**",
        "function": "suggestV2" // <--- CHANGE THIS
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}